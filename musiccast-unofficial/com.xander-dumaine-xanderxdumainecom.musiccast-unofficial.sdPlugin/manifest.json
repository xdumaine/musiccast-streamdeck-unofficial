{
	"Name": "musiccast-unofficial",
	"Version": "0.1.0.0",
	"Author": "xander dumaine (xander@xdumaine.com)",
	"Actions": [
		{
			"Name": "Volume",
			"UUID": "com.xander-dumaine-xanderxdumainecom.musiccast-unofficial.volume",
			"Icon": "imgs/actions/volume/dial",
			"Tooltip": "Turn for volume; push for mute; double-push for power; touch strip to refresh.",
			"PropertyInspectorPath": "ui/volume-dial.html",
			"Controllers": ["Encoder"],
			"Encoder": {
				"layout": "volume-dial.json",
				"TriggerDescription": {
					"Rotate": "Volume up / down",
					"Touch": "Refresh",
					"Push": "Mute · double-press power",
					"LongTouch": "Refresh"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/volume/dial",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Now Playing",
			"UUID": "com.xander-dumaine-xanderxdumainecom.musiccast-unofficial.current-playing",
			"Icon": "imgs/actions/play-pause/icon",
			"Tooltip": "Show current MusicCast playback info from netusb/getPlayInfo.",
			"PropertyInspectorPath": "ui/current-playing.html",
			"Controllers": ["Encoder"],
			"Encoder": {
				"layout": "current-playing-dial.json",
				"TriggerDescription": {
					"Rotate": "Refresh now playing",
					"Touch": "Refresh now playing",
					"Push": "Refresh now playing",
					"LongTouch": "Refresh now playing"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/play-pause/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Album Art",
			"UUID": "com.xander-dumaine-xanderxdumainecom.musiccast-unofficial.album-art",
			"Icon": "imgs/actions/play-pause/icon",
			"Tooltip": "Show current MusicCast album art from netusb/getPlayInfo.",
			"PropertyInspectorPath": "ui/current-playing.html",
			"Controllers": ["Keypad"],
			"States": [
				{
					"Image": "imgs/actions/play-pause/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Source Dial",
			"UUID": "com.xander-dumaine-xanderxdumainecom.musiccast-unofficial.source-dial",
			"Icon": "imgs/actions/source/icon",
			"Tooltip": "Turn to select previous/next MusicCast source; touch or push to refresh.",
			"PropertyInspectorPath": "ui/source-toggle.html",
			"Controllers": ["Encoder"],
			"Encoder": {
				"layout": "source-dial.json",
				"TriggerDescription": {
					"Rotate": "Previous / next source",
					"Touch": "Refresh source",
					"Push": "Refresh source",
					"LongTouch": "Refresh source"
				}
			},
			"States": [
				{
					"Image": "imgs/actions/source/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Source",
			"UUID": "com.xander-dumaine-xanderxdumainecom.musiccast-unofficial.source-toggle",
			"Icon": "imgs/actions/source/icon",
			"Tooltip": "Cycle through configured MusicCast inputs; icon reflects current source.",
			"PropertyInspectorPath": "ui/source-toggle.html",
			"Controllers": ["Keypad"],
			"States": [
				{
					"Image": "imgs/actions/source/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Play",
			"UUID": "com.xander-dumaine-xanderxdumainecom.musiccast-unofficial.play",
			"Icon": "imgs/actions/play/icon",
			"Tooltip": "Net/USB play. Does not control physical turntables/phono inputs.",
			"PropertyInspectorPath": "ui/device-settings.html",
			"Controllers": ["Keypad"],
			"States": [
				{
					"Image": "imgs/actions/play/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Play/Pause",
			"UUID": "com.xander-dumaine-xanderxdumainecom.musiccast-unofficial.play-pause-toggle",
			"Icon": "imgs/actions/play-pause/icon",
			"Tooltip": "Toggle Net/USB play/pause. Does not control physical turntables/phono inputs.",
			"PropertyInspectorPath": "ui/device-settings.html",
			"Controllers": ["Keypad"],
			"States": [
				{
					"Image": "imgs/actions/play-pause/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Stop",
			"UUID": "com.xander-dumaine-xanderxdumainecom.musiccast-unofficial.stop",
