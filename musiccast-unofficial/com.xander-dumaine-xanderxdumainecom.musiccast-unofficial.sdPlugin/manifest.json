			"PropertyInspectorPath": "ui/device-settings.html",
			"Controllers": ["Keypad"],
			"States": [
				{
					"Image": "imgs/actions/stop/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Previous",
			"UUID": "com.xander-dumaine-xanderxdumainecom.musiccast-unofficial.previous",
			"Icon": "imgs/actions/previous/icon",
			"Tooltip": "Net/USB previous track.",
			"PropertyInspectorPath": "ui/device-settings.html",
			"Controllers": ["Keypad"],
			"States": [
				{
					"Image": "imgs/actions/previous/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Next",
			"UUID": "com.xander-dumaine-xanderxdumainecom.musiccast-unofficial.next",
			"Icon": "imgs/actions/next/icon",
			"Tooltip": "Net/USB next track.",
			"PropertyInspectorPath": "ui/device-settings.html",
			"Controllers": ["Keypad"],
			"States": [
				{
					"Image": "imgs/actions/next/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Mute",
			"UUID": "com.xander-dumaine-xanderxdumainecom.musiccast-unofficial.mute-toggle",
			"Icon": "imgs/actions/mute/icon",
			"Tooltip": "Toggle mute on the selected zone.",
			"PropertyInspectorPath": "ui/device-settings.html",
			"Controllers": ["Keypad"],
			"States": [
				{
					"Image": "imgs/actions/mute/key",
					"ShowTitle": false
				}
			]
		},
		{
			"Name": "Power",
			"UUID": "com.xander-dumaine-xanderxdumainecom.musiccast-unofficial.power-toggle",
			"Icon": "imgs/actions/power/icon",
			"Tooltip": "Power toggle (main/setPower?power=toggle).",
			"PropertyInspectorPath": "ui/device-settings.html",
			"Controllers": ["Keypad"],
			"States": [
				{
					"Image": "imgs/actions/power/key",
					"ShowTitle": false
				}
			]
